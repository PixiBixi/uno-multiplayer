# Copy to .env for local development. Every value below is the default.
NODE_ENV=development
HOST=0.0.0.0
PORT=5050
# Comma-separated allowlist. Empty means same-origin only.
CORS_ORIGIN=
GRACE_PERIOD_MS=60000
MAX_ROOMS=500
LOG_LEVEL=info

# Path to the built client. Empty serves no static files (API-only).
STATIC_ROOT=

# Rate limits. Move budget is sized for a human, chat is tighter.
MOVE_BURST=20
MOVE_PER_SECOND=2
CHAT_BURST=5
CHAT_PER_SECOND=0.5
